# GameHub Environment Variables
# Copy to .env and fill. Never commit .env.

# MongoDB - replicaSet rs0 recommended for transactions (see docs/05-nosql-design.md)
# Example with replicaSet: mongodb://localhost:27017/gamehub?replicaSet=rs0
# Fallback without replicaSet: mongodb://localhost:27017/gamehub
MONGODB_URI=mongodb://localhost:27017/gamehub?replicaSet=rs0
MONGODB_DB=gamehub

# Auth
AUTH_SECRET=change-me-to-32-random-chars-min
ORIGIN=http://localhost:5173

# Operating hours (HH:MM-HH:MM, overnight allowed e.g. 09:00-02:00)
OPERATING_HOURS=09:00-02:00

# Seed admin (used by bun run seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_CASHIER_USERNAME=cashier1
SEED_CASHIER_PASSWORD=Cashier123!
